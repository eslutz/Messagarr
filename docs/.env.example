# Messagarr Environment Variables
# Copy this file to .env and fill in your actual values

# Application Configuration
CONFIG_PATH=config/messagarr/config.yaml
LOG_LEVEL=info
ENV=development
TZ=America/New_York

# SMTP/Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=alerts@example.com
EMAIL_TO=admin@example.com

# Discord Configuration
# Create webhook: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Slack Configuration
# Create webhook: Workspace Settings → Apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Microsoft Teams Configuration
# Create webhook: Channel → Connectors → Incoming Webhook
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR_WEBHOOK_URL

# Grafana Configuration (optional, for docker-compose with monitoring stack)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
