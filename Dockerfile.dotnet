# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy solution and project files
COPY Messagarr.DotNet.sln .
COPY src/Messagarr.Api/Messagarr.Api.csproj src/Messagarr.Api/
COPY src/Messagarr.Core/Messagarr.Core.csproj src/Messagarr.Core/
COPY src/Messagarr.Data/Messagarr.Data.csproj src/Messagarr.Data/
COPY tests/Messagarr.Tests/Messagarr.Tests.csproj tests/Messagarr.Tests/

# Restore dependencies
RUN dotnet restore

# Copy source code
COPY src/ src/
COPY tests/ tests/

# Build application
WORKDIR /src/src/Messagarr.Api
RUN dotnet publish -c Release -o /app/publish

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Create non-root user
RUN groupadd -r messagarr && useradd -r -g messagarr messagarr

# Create data directory
RUN mkdir -p /config && chown -R messagarr:messagarr /config

# Copy published application
COPY --from=build /app/publish .

# Switch to non-root user
USER messagarr

# Set environment variables
ENV ASPNETCORE_URLS=http://+:4545 \
    DataDirectory=/config

# Expose port
EXPOSE 4545

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:4545/health || exit 1

# Run application
ENTRYPOINT ["dotnet", "Messagarr.Api.dll"]
